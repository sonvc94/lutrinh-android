<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Map style + tiles (MapLibre + OpenFreeMap), road routing while "Tính đường đi" is on (R36),
         the Lữ Trình route server when the user enters a route code (R40), and the redirect of a Google
         Maps link shared into the app (R43). No other network use. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Offline maps (R15): know when the device is offline to show the offline indicator. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Step photos come from the system Photo Picker (no permission).
         "Ảnh chụp trong lúc dừng" (R19) reads the gallery for photos taken during a stop
         suggestion: asked only from that section, after an explanation; Android 14+ partial
         access (selected photos) is accepted. Nothing is copied until the step is saved. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- "Thêm từ ảnh" (R13) opens the system file picker and needs this permission to read the
         GPS position in the photos' EXIF (Android 10+ redacts it otherwise). The stored copies
         are still saved without location (R11). -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <!-- "Ghi hành trình" (R16): precise location while the user records a track, asked at the
         first recording (coarse must be asked together with fine on Android 12+). Only the
         foreground service started from the UI uses it: no ACCESS_BACKGROUND_LOCATION. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- The recording notification (elapsed time, distance, stop); asked on Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" tools:node="remove" />

    <application
        android:name=".LuTrinhApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.LuTrinh">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- R43: "Chia sẻ" from Google Maps lists Lữ Trình; only a Google Maps place is used,
                 any other text is answered with a short message (MainActivity). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <service
            android:name=".tracking.TrackRecordingService"
            android:exported="false"
            android:foregroundServiceType="location" />
        <!-- "Chia sẻ chuyến đi" (R18): content:// URIs for the exported image/page in cacheDir/share. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>
    </application>
</manifest>
