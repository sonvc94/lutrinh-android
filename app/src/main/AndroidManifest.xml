<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Only for map tiles (MapLibre + OpenStreetMap). No other network use. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- No storage/media read permission: step photos come from the system Photo Picker.
         "Thêm từ ảnh" (R13) opens the system file picker and needs this permission to read the
         GPS position in the photos' EXIF (Android 10+ redacts it otherwise). The stored copies
         are still saved without location (R11). -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <!-- MapLibre declares location permissions for its location component, which the app does
         not use (no tracking / my-location in this phase). Network/Wi-Fi state stay: MapLibre
         uses them to pause tile requests while offline. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" tools:node="remove" />

    <application
        android:name=".LuTrinhApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.LuTrinh">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
