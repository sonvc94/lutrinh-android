    <!-- Offline maps (R15) -->
    <string name="offline_title">Bản đồ offline</string>
    <string name="offline_intro">Tải sẵn bản đồ một vùng để vẫn xem được đường đi, làng bản và lộ trình khi mất sóng. Bản đồ © OpenStreetMap, qua OpenFreeMap.</string>
    <string name="offline_section_ready">Vùng có sẵn</string>
    <string name="offline_section_trip">Chuyến đi này</string>
    <string name="offline_section_trips">Vùng của các chuyến đi</string>
    <string name="offline_trip_area">Tải vùng của chuyến đi này</string>
    <string name="offline_trip_area_body">Khung bao mọi điểm dừng của “%1$s”, thêm %2$d km mỗi phía.</string>
    <string name="offline_trip_no_steps">Chuyến đi chưa có điểm dừng nào để tải bản đồ.</string>
