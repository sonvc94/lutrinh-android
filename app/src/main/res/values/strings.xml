    <!-- Steps from photos (R13) -->
    <string name="from_photos_title">Thêm từ ảnh</string>
    <string name="from_photos_pick">Chọn ảnh</string>
    <string name="from_photos_pick_hint">Chọn nhiều ảnh: ảnh có vị trí và ngày chụp sẽ được gom thành các điểm dừng gợi ý. Cho phép truy cập vị trí trong ảnh để gom theo nơi chụp.</string>
    <string name="from_photos_intro_title">Thêm điểm dừng từ ảnh</string>
    <string name="from_photos_intro_gps">Chọn ảnh có vị trí GPS và ngày chụp: Lữ Trình gom ảnh cùng ngày, cùng nơi thành các điểm dừng gợi ý để bạn xem lại.</string>
    <string name="from_photos_intro_review">Chưa có gì được tạo cho đến khi bạn bấm “Tạo điểm dừng”. Ảnh gốc trong máy không bị thay đổi.</string>
    <string name="from_photos_intro_permission">Máy sẽ hỏi quyền xem vị trí trong ảnh; nếu từ chối, ảnh vẫn được thêm nhưng bạn phải tự chọn vị trí.</string>
    <string name="from_photos_discard_title">Bỏ các điểm dừng gợi ý?</string>
    <string name="from_photos_discard_body">Chưa có điểm dừng nào được tạo từ %1$d ảnh này. Thoát bây giờ sẽ bỏ phần đã gom.</string>
    <string name="from_photos_summary">%1$d ảnh → %2$d điểm dừng gợi ý</string>
    <string name="from_photos_summary_hint">Gom theo ngày chụp và vị trí (cách nhau dưới 2 km). Sửa tên, bỏ chọn nhóm không cần, đặt vị trí cho ảnh không có vị trí.</string>
